# Required -- your API key for the LLM provider
OPENAI_API_KEY=b05f69cea8c5438cbff9bdbbe4e90d09.N1QFMVKdc5N2Wyu8

# API base URL (default: OpenRouter)
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# Model to use
MODEL=glm-5.2

# Max agent loop iterations per query
MAX_ITERATIONS=30

# SQLite database path (used from s03 onward)
DB_PATH=state.db

# Hermes home directory for memory/skills/config (used from s04 onward)
HERMES_HOME=~/.hermes

# Fallback model for error recovery (used from s06 onward, optional)
FALLBACK_MODEL=deepseek-v4-flash
FALLBACK_BASE_URL=https://api.deepseek.com
FALLBACK_API_KEY=sk-91621264d96d40369449048221248280