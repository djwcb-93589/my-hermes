# Required -- API key for the primary LLM provider.
OPENAI_API_KEY=
# OpenAI-compatible API base URL.
OPENAI_BASE_URL=
# Model to use
MODEL=glm-5.2
# Max agent loop iterations per query
MAX_ITERATIONS=30

# DB_PATH and HERMES_HOME are intentionally not set here.
# Defaults (from hermes/config.py):
#   HERMES_HOME = project root
#   DB_PATH     = <HERMES_HOME>/database/hermes.db
# Override below only if you want a different location.

# Dashboard overrides. The YAML defaults bind only to 127.0.0.1:8000 and do
# not require read authentication. A non-loopback host always requires a valid
# HERMES_WEB_CONTROL_TOKEN (at least 32 trimmed characters); never put it in a URL.
# HERMES_DASHBOARD_HOST=127.0.0.1
# HERMES_DASHBOARD_PORT=8000
# HERMES_DASHBOARD_AUTH_REQUIRED=false
# HERMES_WEB_CONTROL_TOKEN=

# Fallback model for error recovery (used from s06 onward, optional)
FALLBACK_MODEL=deepseek-v4-pro
FALLBACK_BASE_URL=
FALLBACK_API_KEY=

# Doubao multimodal provider (optional)
ARK_API_KEY=
ARK_BASE_URL=
DOUBAO_MULTIMODAL_MODEL=Doubao-Seed-2.0-lite
